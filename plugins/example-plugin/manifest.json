{
	"format": 1,
	"id": "com.example.plugin",
	"name": "Example Plugin",
	"description": "An example Valenced plugin built from the template.",
	"author": "Your Name <643945264868098049> (https://discord.com \"Website\")",
	"contributors": [
		"Someone Else <669627189624307712> (mailto:support@discord.com)",
		"Some Other Person"
	],
	"version": "1.0.0",
	"dependencies": {
		"valenced.api": {
			"version": ">=1 <2"
		},
		"discord": {
			"version": "*"
		}
	},
	"settings": [
		{
			"key": "showAlert",
			"type": "switch",
			"label": "Show alert on start",
			"default": true
		},
		{
			"key": "alertTitle",
			"type": "text",
			"label": "Alert title",
			"default": "Hello",
			"maxLength": 32,
			"showIf": {
				"key": "showAlert",
				"equals": true
			}
		}
	],
	"dist": {
		"script": "index.js",
		"android": {
			"path": "plugin.jar",
			"class": "com.example.plugin.MyPlugin"
		}
	}
}
